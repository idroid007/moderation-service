# ───────── Server ─────────
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info                        # debug | info | warn | error

# ───────── Model ─────────
MODEL_PROVIDER=nsfwjs                 # nsfwjs | huggingface
MODEL_PATH=                           # optional custom model path; empty = use default

# ───────── Thresholds ─────────
REJECT_THRESHOLD=0.80
FLAG_THRESHOLD=0.50
SEXY_WEIGHT=0.70                      # multiplier for 'sexy' category in risk score

# ───────── Video ─────────
DEFAULT_FRAME_COUNT=5
MAX_VIDEO_DURATION_SECONDS=300
FFMPEG_PATH=/usr/bin/ffmpeg

# ───────── Limits ─────────
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm

# ───────── Auth ─────────
API_KEY=                              # if set, all requests must include X-Api-Key header
